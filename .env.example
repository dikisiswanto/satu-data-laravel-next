# Public HTTPS origin served by your VPS reverse proxy.
NEXT_PUBLIC_SITE_URL=https://data.example.go.id
NEXT_PUBLIC_GEOPORTAL_URL=https://geoportal-wajo.vercel.app

# Compose build-time and internal server-to-server API route.
BACKEND_API_URL=http://api-http:8080

# PHP extension compilation parallelism; use 1 on low-RAM VPS.
PHP_EXT_BUILD_JOBS=2

# Persistent MariaDB credentials. Keep root and application passwords different.
DB_DATABASE=satu_data_wajo
DB_USERNAME=satu_data_wajo
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Bind the Docker edge to loopback when host Nginx/Caddy terminates HTTPS.
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080

# Optional Cloudflare Tunnel profile (leave unset if using host Nginx/Caddy).
CLOUDFLARE_TUNNEL_TOKEN=
