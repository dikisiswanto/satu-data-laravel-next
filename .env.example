# Contoh generik multi-instansi. Isi identitas wilayah/instansi di bawah sebelum deployment.
COMPOSE_PROJECT_NAME=portal-satu-data
DB_DATABASE=portal_satu_data
DB_USERNAME=portal_satu_data
DB_PASSWORD=replace-with-at-least-32-unique-characters
DB_ROOT_PASSWORD=replace-with-a-different-32-character-secret
NEXT_PUBLIC_SITE_URL=https://example.test
# Identitas tenant bersifat opsional. Tanpa nilai ini UI memakai branding generik.
NEXT_PUBLIC_REGION_NAME=
NEXT_PUBLIC_BRAND_PROFILE=generic
NEXT_PUBLIC_REGION_SHORT_NAME=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_SHORT_NAME=
NEXT_PUBLIC_ORGANIZATION_NAME=
NEXT_PUBLIC_PUBLIC_SUBTITLE=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_LOGO_PATH=
NEXT_PUBLIC_LOGO_ALT=
NEXT_PUBLIC_HERO_IMAGE=
NEXT_PUBLIC_PPID_NAME=
NEXT_PUBLIC_PPID_URL=
NEXT_PUBLIC_PPID_CONTACT_URL=
NEXT_PUBLIC_PPID_ADDRESS=
NEXT_PUBLIC_PPID_EMAIL=
NEXT_PUBLIC_PPID_PHONE=
FRONTEND_TOKEN_COOKIE=portal_session_token
NEXT_PUBLIC_GEOPORTAL_URL=
BACKEND_API_URL=http://api-http:8080
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080
PHP_EXT_BUILD_JOBS=2
CLOUDFLARE_TUNNEL_TOKEN=

# Saran kategori dataset, pisahkan dengan tanda |. Kosongkan untuk memakai daftar bawaan.
NEXT_PUBLIC_DATASET_CATEGORIES=
