# Default deployment mengikuti Kabupaten Wajo; seluruh identitas tetap dapat diganti untuk tenant lain.
COMPOSE_PROJECT_NAME=portal-satu-data
DB_DATABASE=portal_satu_data
DB_USERNAME=portal_satu_data
DB_PASSWORD=replace-with-at-least-32-unique-characters
DB_ROOT_PASSWORD=replace-with-a-different-32-character-secret
NEXT_PUBLIC_SITE_URL=https://example.test
# Default Wajo dapat diganti lewat environment untuk tenant lain.
NEXT_PUBLIC_REGION_NAME=Kabupaten Wajo
NEXT_PUBLIC_BRAND_PROFILE=wajo
NEXT_PUBLIC_REGION_SHORT_NAME=Wajo
NEXT_PUBLIC_APP_NAME=Portal Satu Data Kabupaten Wajo
NEXT_PUBLIC_SHORT_NAME=Satu Data Wajo
NEXT_PUBLIC_ORGANIZATION_NAME=Pemerintah Kabupaten Wajo
NEXT_PUBLIC_PUBLIC_SUBTITLE=Portal Data Kabupaten Wajo
NEXT_PUBLIC_SITE_DESCRIPTION=Portal resmi untuk menemukan, memahami, dan menggunakan data publik Kabupaten Wajo.
NEXT_PUBLIC_LOGO_PATH=/logo-kabupaten-wajo.webp
NEXT_PUBLIC_LOGO_ALT=Lambang Kabupaten Wajo
NEXT_PUBLIC_HERO_IMAGE=/wajo-hero-panorama.webp
NEXT_PUBLIC_ICON_PATH=/icons/icon.svg
NEXT_PUBLIC_PWA_ICON_192=/icons/icon-192.png
NEXT_PUBLIC_PWA_ICON_512=/icons/icon-512.png
NEXT_PUBLIC_PPID_NAME=PPID Kabupaten Wajo
NEXT_PUBLIC_PPID_URL=https://e-ppid-utama.wajokab.go.id/
NEXT_PUBLIC_PPID_CONTACT_URL=https://e-ppid-utama.wajokab.go.id/kontak/
NEXT_PUBLIC_PPID_ADDRESS=Jl. Rusa No. 17, Bulu Pabbulu, Kecamatan Tempe, Kabupaten Wajo, Sulawesi Selatan 90911
NEXT_PUBLIC_PPID_EMAIL=ppid@wajokab.go.id
NEXT_PUBLIC_PPID_PHONE=+62 811-4780-6767
FRONTEND_TOKEN_COOKIE=portal_session_token
NEXT_PUBLIC_GEOPORTAL_URL=
BACKEND_API_URL=http://api-http:8080
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080
PHP_EXT_BUILD_JOBS=2
CLOUDFLARE_TUNNEL_TOKEN=

# Saran kategori dataset, pisahkan dengan tanda |. Kosongkan untuk memakai daftar bawaan.
NEXT_PUBLIC_DATASET_CATEGORIES=
