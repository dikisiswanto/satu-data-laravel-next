# Production Next.js standalone image. Keep build-time and runtime API URLs internal.
FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS builder
WORKDIR /app
ARG BACKEND_API_URL=http://api-http:8080
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_GEOPORTAL_URL=
ARG NEXT_PUBLIC_APP_NAME="Portal Satu Data Kabupaten Wajo"
ARG NEXT_PUBLIC_SHORT_NAME="Satu Data Wajo"
ARG NEXT_PUBLIC_REGION_NAME="Kabupaten Wajo"
ARG NEXT_PUBLIC_BRAND_PROFILE=wajo
ARG NEXT_PUBLIC_REGION_SHORT_NAME=Wajo
ARG NEXT_PUBLIC_ORGANIZATION_NAME="Pemerintah Kabupaten Wajo"
ARG NEXT_PUBLIC_PUBLIC_SUBTITLE="Portal Data Kabupaten Wajo"
ARG NEXT_PUBLIC_PORTAL_TITLE="Portal Admin"
ARG NEXT_PUBLIC_SITE_DESCRIPTION="Portal resmi untuk menemukan, memahami, dan menggunakan data publik Kabupaten Wajo."
ARG NEXT_PUBLIC_LOGO_PATH=/logo-kabupaten-wajo.webp
ARG NEXT_PUBLIC_LOGO_ALT="Lambang Kabupaten Wajo"
ARG NEXT_PUBLIC_HERO_IMAGE=/wajo-hero-panorama.webp
ARG NEXT_PUBLIC_ICON_PATH=/icons/icon.svg
ARG NEXT_PUBLIC_PWA_ICON_192=/icons/icon-192.png
ARG NEXT_PUBLIC_PWA_ICON_512=/icons/icon-512.png
ARG NEXT_PUBLIC_PPID_NAME="PPID Kabupaten Wajo"
ARG NEXT_PUBLIC_PPID_URL=https://e-ppid-utama.wajokab.go.id/
ARG NEXT_PUBLIC_PPID_CONTACT_URL=https://e-ppid-utama.wajokab.go.id/kontak/
ARG NEXT_PUBLIC_PPID_ADDRESS="Jl. Rusa No. 17, Bulu Pabbulu, Kecamatan Tempe, Kabupaten Wajo, Sulawesi Selatan 90911"
ARG NEXT_PUBLIC_PPID_EMAIL=ppid@wajokab.go.id
ARG NEXT_PUBLIC_PPID_PHONE="+62 811-4780-6767"
ARG NEXT_PUBLIC_LOCALE=id-ID
ARG NEXT_PUBLIC_TIME_ZONE=Asia/Makassar
ARG NEXT_PUBLIC_DATASET_CATEGORIES=
ARG FRONTEND_TOKEN_COOKIE=portal_session_token
ENV BACKEND_API_URL=${BACKEND_API_URL} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_GEOPORTAL_URL=${NEXT_PUBLIC_GEOPORTAL_URL} \
    NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME} \
    NEXT_PUBLIC_SHORT_NAME=${NEXT_PUBLIC_SHORT_NAME} \
    NEXT_PUBLIC_REGION_NAME=${NEXT_PUBLIC_REGION_NAME} \
    NEXT_PUBLIC_BRAND_PROFILE=${NEXT_PUBLIC_BRAND_PROFILE} \
    NEXT_PUBLIC_REGION_SHORT_NAME=${NEXT_PUBLIC_REGION_SHORT_NAME} \
    NEXT_PUBLIC_ORGANIZATION_NAME=${NEXT_PUBLIC_ORGANIZATION_NAME} \
    NEXT_PUBLIC_PUBLIC_SUBTITLE=${NEXT_PUBLIC_PUBLIC_SUBTITLE} \
    NEXT_PUBLIC_PORTAL_TITLE=${NEXT_PUBLIC_PORTAL_TITLE} \
    NEXT_PUBLIC_SITE_DESCRIPTION=${NEXT_PUBLIC_SITE_DESCRIPTION} \
    NEXT_PUBLIC_LOGO_PATH=${NEXT_PUBLIC_LOGO_PATH} \
    NEXT_PUBLIC_LOGO_ALT=${NEXT_PUBLIC_LOGO_ALT} \
    NEXT_PUBLIC_HERO_IMAGE=${NEXT_PUBLIC_HERO_IMAGE} \
    NEXT_PUBLIC_ICON_PATH=${NEXT_PUBLIC_ICON_PATH} \
    NEXT_PUBLIC_PWA_ICON_192=${NEXT_PUBLIC_PWA_ICON_192} \
    NEXT_PUBLIC_PWA_ICON_512=${NEXT_PUBLIC_PWA_ICON_512} \
    NEXT_PUBLIC_PPID_NAME=${NEXT_PUBLIC_PPID_NAME} \
    NEXT_PUBLIC_PPID_URL=${NEXT_PUBLIC_PPID_URL} \
    NEXT_PUBLIC_PPID_CONTACT_URL=${NEXT_PUBLIC_PPID_CONTACT_URL} \
    NEXT_PUBLIC_PPID_ADDRESS=${NEXT_PUBLIC_PPID_ADDRESS} \
    NEXT_PUBLIC_PPID_EMAIL=${NEXT_PUBLIC_PPID_EMAIL} \
    NEXT_PUBLIC_PPID_PHONE=${NEXT_PUBLIC_PPID_PHONE} \
    NEXT_PUBLIC_LOCALE=${NEXT_PUBLIC_LOCALE} \
    NEXT_PUBLIC_TIME_ZONE=${NEXT_PUBLIC_TIME_ZONE} \
    NEXT_PUBLIC_DATASET_CATEGORIES=${NEXT_PUBLIC_DATASET_CATEGORIES} \
    FRONTEND_TOKEN_COOKIE=${FRONTEND_TOKEN_COOKIE} \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    FRONTEND_TOKEN_COOKIE=portal_session_token \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
