APP_NAME="Satu Data Wajo API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
API_PUBLIC_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar
FRONTEND_URL=http://localhost:3000
FRONTEND_TOKEN_COOKIE=wajo_portal_token
FRONTEND_TOKEN_TTL_DAYS=14
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=satu_data_wajo
DB_USERNAME=satu_data_wajo
DB_PASSWORD=change-this-database-password

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=private
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_PATH=storage/app/private
# Used only for S3-compatible object storage; empty means bucket root.
PRIVATE_STORAGE_PREFIX=
# Optional S3-compatible private object storage (MinIO, AWS S3, Cloudflare R2, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
UPLOAD_MAX_BYTES=26214400
CONVERSION_MAX_ROWS=100000
CONVERSION_MAX_COLUMNS=100
CONVERSION_MAX_CELLS=200000
CONVERSION_JOB_TIMEOUT=900
RATE_LIMIT_PER_MINUTE=120

# Optional migration/import source. Read-only PostgreSQL URL for the previous Supabase database.
LEGACY_SUPABASE_DATABASE_URL=
# The bundled edge proxy overwrites X-Forwarded-For and the API gateway is private to the Compose network.
# For deployments with a different proxy topology, configure only your actual trusted proxy CIDR(s).
TRUSTED_PROXIES=*

# Public address of the Laravel API, reachable directly by browsers for binary upload.
# Upload URL defaults to same-origin /api/... so it works behind a reverse proxy.
PUBLIC_BACKEND_API_URL=

# Mail delivery for password reset. Use SMTP or a provider in production.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Satu Data Wajo"
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
