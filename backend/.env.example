# Konfigurasi contoh Laravel. Jangan commit file backend/.env yang berisi rahasia.
APP_NAME="Satu Data Wajo API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.test
API_PUBLIC_URL=https://example.test
FRONTEND_URL=https://example.test
LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=satu_data_wajo
DB_USERNAME=satu_data_wajo
DB_PASSWORD=

# Berkas unggahan sumber selalu disimpan di disk privat, bukan public/storage.
FILESYSTEM_DISK=private
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_PATH=storage/app/private
PRIVATE_STORAGE_PREFIX=
TRUSTED_PROXIES=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
