# Konfigurasi contoh Laravel. Jangan commit file backend/.env yang berisi rahasia.
APP_NAME=
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.test
API_PUBLIC_URL=https://example.test
FRONTEND_URL=https://example.test
PORTAL_REGION_NAME=
PORTAL_REGION_SHORT_NAME=
PORTAL_ORGANIZATION_NAME=
PORTAL_BRAND_NAME=
SDI_EXPORT_PROFILE_ID=
GEOPORTAL_MANIFEST_PROFILE_ID=
LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=satu_data_portal
DB_USERNAME=satu_data_portal
DB_PASSWORD=

# Berkas unggahan sumber selalu disimpan di disk privat, bukan public/storage.
FILESYSTEM_DISK=private
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_PATH=storage/app/private
PRIVATE_STORAGE_PREFIX=
TRUSTED_PROXIES=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

# Shared per-token/per-user budgets for authenticated sessions; anonymous
# public traffic remains separately constrained.
RATE_LIMIT_PER_MINUTE=1200
PORTAL_USER_RATE_LIMIT_PER_MINUTE=1200
ANONYMOUS_RATE_LIMIT_PER_MINUTE=120

# Additional anti-automation budgets for portal mutations (per user and per source IP).
PORTAL_WRITE_USER_RATE_LIMIT_PER_MINUTE=120
PORTAL_WRITE_IP_RATE_LIMIT_PER_MINUTE=300
